# ---- Database ---------------------------------------------------------------
# Local default: a SQLite file (no setup needed). Use Postgres for the real deployment.
CG_DATABASE_URL=sqlite:///./data/changeguard.db
# Postgres example (docker compose maps host port 5434 to avoid clashing with other projects):
# CG_DATABASE_URL=postgresql://cg_admin:cg_admin_dev@localhost:5434/changeguard
# Optional per-role DSNs for least privilege (fall back to CG_DATABASE_URL if unset):
# CG_DATABASE_URL_READER=postgresql://cg_reader:cg_reader_dev@localhost:5434/changeguard
# CG_DATABASE_URL_RECORDER=postgresql://cg_recorder:cg_recorder_dev@localhost:5434/changeguard
# CG_DATABASE_URL_SANDBOX=postgresql://cg_sandbox:cg_sandbox_dev@localhost:5434/changeguard

# ---- LLM provider (the application's model, unrelated to the assistant you code with) ----
# mock  = deterministic offline policy used only for tests/plumbing (NOT a real model)
# gemini | openai = real hosted tool calling
CG_LLM_PROVIDER=mock
CG_LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: price table for cost reporting. Leave unset => cost is reported as "unavailable".
# CG_PRICING_JSON={"your-model-name": {"input_per_mtok": 0.0, "output_per_mtok": 0.0}}

# ---- Agent limits ----
CG_MAX_STEPS=24
CG_MAX_RETRIES_PER_TOOL=2
CG_WALL_CLOCK_SECONDS=90
CG_MAX_TOTAL_TOKENS=80000
CG_TOOL_TIMEOUT_SECONDS=10
CG_MAX_AGENT_RUNS_PER_DAY=40

# ---- Auth for the demo (user:role:token, comma separated). Roles: viewer, analyst, reviewer, admin ----
CG_DEMO_TOKENS=analyst1:analyst:change-me-analyst,reviewer1:reviewer:change-me-reviewer,admin1:admin:change-me-admin
# Role used when no token is sent (public demo visitors). Keep as viewer unless you accept the cost/risk.
CG_ANONYMOUS_ROLE=viewer

# ---- Safety switches ----
CG_ALLOW_RESET=0
CG_TEST_HOOKS=0

# ---- Observability (optional OpenTelemetry/Phoenix bridge) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
